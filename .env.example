# Copy to .env and fill in. Names only here, never real values.

# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Throwaway Neon branch for database tests. Must be a different database from the two above (tests drop tables).
DATABASE_URL_TEST=

# Inbound email (Resend)
EMAIL_WEBHOOK_SECRET=
RESEND_API_KEY=

# Shared secret the intake routes send to /api/worker (generate with: openssl rand -hex 32)
WORKER_SECRET=

# Proposales API
PROPOSALES_API_KEY=
PROPOSALES_COMPANY_ID=

# LLM (name confirmed against the AI SDK docs in T9)
AI_GATEWAY_API_KEY=
# Optional gateway model id for extraction, e.g. anthropic/claude-haiku-4.5. Unset uses the default in lib/extraction/extract.ts.
EXTRACTION_MODEL=
