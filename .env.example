# Copy to .env and fill in. Names only here, never real values.

# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Throwaway Neon branch for database tests. Must be a different database from the two above (tests drop tables).
DATABASE_URL_TEST=

# Inbound email (Resend)
EMAIL_WEBHOOK_SECRET=
RESEND_API_KEY=
# The address people email, shown on the dashboard. Public on purpose (NEXT_PUBLIC_ is baked in at build time: redeploy after changing it).
NEXT_PUBLIC_INBOUND_ADDRESS=

# Shared secret the intake routes send to /api/worker (generate with: openssl rand -hex 32)
WORKER_SECRET=
# Secret for /api/sweeper and /api/chaos. Vercel's daily cron sends it automatically when this variable is set in the
# project; "run sweeper now" sends it too. Different from WORKER_SECRET on purpose. (openssl rand -hex 32)
CRON_SECRET=

# Proposales API
PROPOSALES_API_KEY=
PROPOSALES_COMPANY_ID=
# Optional. Overrides the API base URL (default https://api.proposales.com).
PROPOSALES_BASE_URL=

# LLM (name confirmed against the AI SDK docs)
AI_GATEWAY_API_KEY=
# Optional gateway model id for extraction. Unset uses the default in lib/extraction/extract.ts.
EXTRACTION_MODEL=
